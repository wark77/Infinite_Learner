"""
coded with Claude Sonnet 5.5  (extremely minor modifications by me to find the points where it overtakes the existing algs, still needs more testing but interesting results, especially the smooth curve from ray)

Test of one narrow claim:

  "Using gradients at 2-3 perturbation scales to set the step size beats a
   tuned learning rate per unit of compute."

Setup
-----
* Task: sklearn digits (offline), tanh MLP 64-64-64-64-64-10, minibatch 128.
* Compute is measured in gradient evaluations (one forward+backward = 1.0,
  forward-only = 1/3). Every method gets the same budget.
* Every method's hyperparameters are tuned (on the mean log train loss along the whole curve,
  since the claim is about optimisation speed) with separate tuning seeds;
  final numbers use fresh seeds.

Methods
-------
  adam     : Adam, tuned lr
  sgdm     : SGD + momentum 0.9, tuned lr
  armijo   : plain gradient step with backtracking (Armijo) line search
  curv     : step = 1/(d^T H d) along the gradient direction d, with H*d from a
             finite-difference of gradients (1 extra grad eval). This is the
             "curvature" baseline that the multi-scale idea has to beat.
  ray      : 1D raymarching step distance: grow the step while the gradient still
             agrees and loss hasn't risen, shrink + retry on divergence, carry
             the step size across iterations (see class Ray).
  msa      : YOUR IDEA ("multi-scale agreement"). Probe gradients at distances
             s0, s0*r, s0*r^2 ... along -g. Take the largest distance whose
             gradient still points the same way (cosine >= tau) as the
             starting gradient, ALL smaller scales also agreeing.

All probes use the same minibatch as the base gradient so that cosine
similarity measures the landscape, not batch noise.

Run:  python msa_experiment.py            (full, a few minutes)
      python msa_experiment.py --quick    (smoke test)
"""
import argparse
import itertools
import json
import os
import time

import numpy as np
from sklearn.datasets import load_digits
from sklearn.model_selection import train_test_split

DT = np.float64
LAYERS = [64, 64, 64, 64, 64, 10]


# ----------------------------------------------------------------------------
# Data + model (hand-written backprop so there are no heavy dependencies)
# ----------------------------------------------------------------------------
def load_data():
    X, y = load_digits(return_X_y=True)
    X = X / 16.0
    Xtr, Xtmp, ytr, ytmp = train_test_split(X, y, test_size=0.4, stratify=y, random_state=0)
    Xva, Xte, yva, yte = train_test_split(Xtmp, ytmp, test_size=0.5, stratify=ytmp, random_state=0)
    mu, sd = Xtr.mean(0), Xtr.std(0) + 0.1
    f = lambda A: ((A - mu) / sd).astype(DT)
    return dict(train=(f(Xtr), ytr), val=(f(Xva), yva), test=(f(Xte), yte))


SHAPES = [(LAYERS[i], LAYERS[i + 1]) for i in range(len(LAYERS) - 1)]
SIZES = [a * b + b for a, b in SHAPES]
N_PARAMS = sum(SIZES)


def init_params(rng):
    parts = []
    for a, b in SHAPES:
        parts.append((rng.standard_normal((a, b)) * np.sqrt(1.0 / a)).ravel())
        parts.append(np.zeros(b))
    return np.concatenate(parts).astype(DT)


def unpack(w):
    out, i = [], 0
    for a, b in SHAPES:
        W = w[i:i + a * b].reshape(a, b); i += a * b
        bias = w[i:i + b]; i += b
        out.append((W, bias))
    return out


def loss_only(w, X, y):
    h = X
    layers = unpack(w)
    for k, (W, b) in enumerate(layers):
        h = h @ W + b
        if k < len(layers) - 1:
            h = np.tanh(h)
    h = h - h.max(1, keepdims=True)
    lse = np.log(np.exp(h).sum(1))
    return float(np.mean(lse - h[np.arange(len(y)), y]))


def loss_and_grad(w, X, y):
    layers = unpack(w)
    acts, h = [X], X
    for k, (W, b) in enumerate(layers):
        h = h @ W + b
        if k < len(layers) - 1:
            h = np.tanh(h)
        acts.append(h)
    z = h - h.max(1, keepdims=True)
    e = np.exp(z)
    p = e / e.sum(1, keepdims=True)
    n = len(y)
    loss = float(np.mean(np.log(e.sum(1)) - z[np.arange(n), y]))
    d = p.copy()
    d[np.arange(n), y] -= 1.0
    d /= n
    grads = []
    for k in range(len(layers) - 1, -1, -1):
        W, _ = layers[k]
        gW = acts[k].T @ d
        gb = d.sum(0)
        grads.append(gb); grads.append(gW.ravel())
        if k > 0:
            d = (d @ W.T) * (1.0 - acts[k] ** 2)
    return loss, np.concatenate(grads[::-1])


def accuracy(w, X, y):
    h = X
    layers = unpack(w)
    for k, (W, b) in enumerate(layers):
        h = h @ W + b
        if k < len(layers) - 1:
            h = np.tanh(h)
    return float(np.mean(h.argmax(1) == y))


# ----------------------------------------------------------------------------
# Optimizers. step(w, X, y) -> (new_w, cost_in_gradient_evals)
# ----------------------------------------------------------------------------
class Adam:
    def __init__(self, lr, b1=0.9, b2=0.999):
        self.lr, self.b1, self.b2 = lr, b1, b2
        self.m = self.v = None; self.t = 0

    def step(self, w, X, y):
        _, g = loss_and_grad(w, X, y)
        if self.m is None:
            self.m, self.v = np.zeros_like(w), np.zeros_like(w)
        self.t += 1
        self.m = self.b1 * self.m + (1 - self.b1) * g
        self.v = self.b2 * self.v + (1 - self.b2) * g * g
        mh = self.m / (1 - self.b1 ** self.t)
        vh = self.v / (1 - self.b2 ** self.t)
        return w - self.lr * mh / (np.sqrt(vh) + 1e-8), 1.0


class SGDM:
    def __init__(self, lr, mom=0.9):
        self.lr, self.mom, self.v = lr, mom, None

    def step(self, w, X, y):
        _, g = loss_and_grad(w, X, y)
        self.v = g if self.v is None else self.mom * self.v + g
        return w - self.lr * self.v, 1.0


class Armijo:
    """Gradient descent with backtracking line search on the current minibatch."""
    def __init__(self, lr_max, c=1e-4):
        self.lr_max, self.c, self.lr = lr_max, c, lr_max

    def step(self, w, X, y):
        loss, g = loss_and_grad(w, X, y)
        gn2 = float(g @ g)
        cost = 1.0
        lr = min(self.lr * 2.0, self.lr_max)
        wn = w
        for _ in range(12):
            wn = w - lr * g
            cost += 1.0 / 3.0  # forward-only
            if loss_only(wn, X, y) <= loss - self.c * lr * gn2:
                break
            lr *= 0.5
        self.lr = lr
        return wn, cost


class Curv:
    """Step along -g with length 1/(d^T H d) (exact line-min for a quadratic)."""
    def __init__(self, mult, lr_max, eps=1e-3):
        self.mult, self.lr_max, self.eps = mult, lr_max, eps

    def step(self, w, X, y):
        _, g = loss_and_grad(w, X, y)
        gn = np.linalg.norm(g)
        if gn < 1e-12:
            return w, 2.0
        d = g / gn
        _, g1 = loss_and_grad(w + self.eps * d, X, y)
        curv = float(d @ (g1 - g)) / self.eps
        lr = self.lr_max if curv <= 1e-8 else min(self.mult / curv, self.lr_max)
        return w - lr * g, 2.0


class MSA:
    """Multi-scale agreement step size (the idea under test)."""
    def __init__(self, s0, tau, n_probes=2, ratio=4.0):
        self.scales = [s0 * ratio ** k for k in range(n_probes)]
        self.tau, self.fallback = tau, s0 / ratio
        self.n_probes = n_probes

    def step(self, w, X, y):
        _, g = loss_and_grad(w, X, y)
        gn = np.linalg.norm(g)
        if gn < 1e-12:
            return w, 1.0 + self.n_probes
        d = g / gn
        dist = self.fallback
        for s in self.scales:
            _, gp = loss_and_grad(w - s * d, X, y)
            cos = float(gp @ d) / (np.linalg.norm(gp) + 1e-12)
            if cos >= self.tau:
                dist = s
            else:
                break
        # NB: for simplicity all probes are evaluated every step even though the
        # loop breaks early; cost below charges for all of them (conservative).
        return w - dist * d, 1.0 + self.n_probes


class Ray:
    """1D raymarching step distance (sphere-tracing style line search).

    March along -g from the current point. Each probe evaluates loss+gradient at
    the candidate point (same minibatch). A probe is SAFE if the gradient still
    agrees with the start direction (cosine >= tau) and the loss has not risen
    above the starting loss. Safe  -> advance and grow the step (x grow).
    Unsafe -> do not advance, shrink the step (x shrink) and retry from the
    last safe point. After max_probes probes, take the furthest safe point.
    The step size is carried across iterations, so it tracks the local scale.
    """
    def __init__(self, h0, tau, max_probes=3, grow=2.0, shrink=0.5, hmin=1e-4, hmax=1e4, relative=False):
        # relative=False: h is a step DISTANCE. relative=True: h is a learning-rate
        # multiplier (distance = h*|g|), so steps shrink with the gradient norm.
        self.h, self.tau, self.max_probes, self.relative = h0, tau, max_probes, relative
        self.grow, self.shrink, self.hmin, self.hmax = grow, shrink, hmin, hmax
        
        self.max_probes=3

    def step(self, w, X, y):
        loss0, g = loss_and_grad(w, X, y)
        gn = np.linalg.norm(g)
        if gn < 1e-12:
            return w, 1.0
        d = g / gn
        t, h, last_ok, cost = 0.0, self.h, None, 1.0
        sc = gn if self.relative else 1.0   # converts h to a distance
        for _ in range(self.max_probes):
            lp, gp = loss_and_grad(w - (t + h) * sc * d, X, y)
            cost += 1.0
            cos = float(gp @ d) / (np.linalg.norm(gp) + 1e-12)
            if np.isfinite(lp) and cos >= self.tau and lp <= loss0:
                t += h; last_ok = h; h *= self.grow
            else:
                h *= self.shrink
        if t == 0.0:                 # every probe failed: take the (shrunk) cautious step
            t = h; self.h = max(h, self.hmin)
        else:                        # carry the largest step that was safe
            self.h = min(max(last_ok, self.hmin), self.hmax)
        return w - t * sc * d, cost


# ----------------------------------------------------------------------------
# Training loop
# ----------------------------------------------------------------------------
def run(make_opt, seed, budget, data, record_every=10):
    rng = np.random.default_rng(seed)
    w = init_params(rng)
    opt = make_opt()
    Xtr, ytr = data["train"]
    n, bs = len(ytr), 128
    perm, ptr = rng.permutation(n), 0
    evals, next_rec = 0.0, 0.0
    rec = dict(evals=[], train_loss=[], val_loss=[], test_acc=[])
    diverged = False

    def record():
        tl = loss_only(w, Xtr, ytr)
        vl = loss_only(w, *data["val"])
        if not np.isfinite(tl):
            tl = vl = 10.0
        rec["evals"].append(evals); rec["train_loss"].append(min(tl, 10.0))
        rec["val_loss"].append(min(vl, 10.0)); rec["test_acc"].append(accuracy(w, *data["test"]))

    while evals < budget:
        if evals >= next_rec:
            record(); next_rec += record_every
        if ptr + bs > n:
            perm, ptr = rng.permutation(n), 0
        idx = perm[ptr:ptr + bs]; ptr += bs
        w, cost = opt.step(w, Xtr[idx], ytr[idx])
        evals += cost
        if not np.all(np.isfinite(w)):
            diverged = True
            w = np.nan_to_num(w, nan=0.0, posinf=0.0, neginf=0.0)
            break
    record()
    rec["diverged"] = diverged
    return rec


GRIDS = {
    "adam":   [dict(lr=lr) for lr in (1e-3, 3e-3, 1e-2, 3e-2, 1e-1)],
    "sgdm":   [dict(lr=lr) for lr in (1e-2, 3e-2, 1e-1, 3e-1, 1.0, 3.0)],
    "armijo": [dict(lr_max=m) for m in (10.0, 100.0, 1000.0, 10000.0)],
    "curv":   [dict(mult=m, lr_max=L) for m in (0.25, 0.5, 1.0) for L in (30.0, 300.0, 3000.0)],
    "ray":    [dict(h0=h, tau=t, max_probes=3) for h in (1.0, 3.0, 10.0) for t in (0.5, 0.8, 0.95) ],#for p in (1, 2, 3)],
    "ray_lr": [dict(h0=h, tau=t, max_probes=3, relative=True) for h in (0.1, 0.3, 1.0, 3.0) for t in (0.5, 0.8, 0.95) ],#for p in (1, 2, 3)],
    "msa":    [dict(s0=s, tau=t) for s in (0.1, 0.3, 1.0, 3.0, 10.0) for t in (0.8, 0.9, 0.95)],
}
CLASSES = dict(adam=Adam, sgdm=SGDM, armijo=Armijo, curv=Curv, msa=MSA, ray=Ray, ray_lr=Ray)


def tune(name, data, budget, seeds):
    best, best_score, log = None, np.inf, []
    for cfg in GRIDS[name]:
        scores = []
        for s in seeds:
            r = run(lambda: CLASSES[name](**cfg), s, budget, data, record_every=budget / 20)
            scores.append(float(np.mean(np.log(r["train_loss"][1:]))))  # area under log-loss curve
        sc = float(np.mean(scores))
        log.append((cfg, sc))
        if sc < best_score:
            best, best_score = cfg, sc
    return best, best_score, log


def main():
    #ap = argparse.ArgumentParser()
    #ap.add_argument("--budget", type=float, default=600)
   # ap.add_argument("--quick", action="store_true")
    #ap.add_argument("--out", default=os.path.dirname(os.path.abspath(os.getcwd())))
   # args = ap.parse_args()
    budget = 10000#150 #if args.quick else args.budget
    tune_seeds = [100] #if args.quick else [100, 101]
    final_seeds = [0, 1] #if args.quick else [0, 1, 2, 3, 4]

    data = load_data()
    print(f"params={N_PARAMS}  budget={budget} grad-evals  train={len(data['train'][1])} samples")
    results, chosen = {}, {}
    t0 = time.time()
    for name in GRIDS:
        cfg, sc, log = tune(name, data, budget, tune_seeds)
        chosen[name] = cfg
        print(f"[tune] {name:7s} best={cfg}  mean log train loss={sc:.3f}  ({time.time()-t0:.0f}s)")
        results[name] = [run(lambda: CLASSES[name](**cfg), s, budget, data) for s in final_seeds]

    # summary table
    print("\n=== Final results (mean ± std over %d seeds, budget=%d grad-evals) ===" % (len(final_seeds), budget))
    print(f"{'method':8s} {'train loss':>16s} {'val loss':>16s} {'test acc':>14s} {'evals to train<0.1':>20s}")
    summary = {}
    for name, runs in results.items():
        tl = np.array([r["train_loss"][-1] for r in runs])
        vl = np.array([r["val_loss"][-1] for r in runs])
        ta = np.array([r["test_acc"][-1] for r in runs])
        hit = []
        for r in runs:
            ok = [e for e, l in zip(r["evals"], r["train_loss"]) if l < 0.1]
            hit.append(ok[0] if ok else np.nan)
        hit = np.array(hit)
        hs = "never" if np.all(np.isnan(hit)) else f"{np.nanmean(hit):.0f} ({np.sum(~np.isnan(hit))}/{len(hit)})"
        print(f"{name:8s} {tl.mean():8.4f}±{tl.std():.4f} {vl.mean():8.4f}±{vl.std():.4f} "
              f"{ta.mean():7.3f}±{ta.std():.3f} {hs:>20s}")
        summary[name] = dict(cfg=chosen[name], train_loss=tl.tolist(), val_loss=vl.tolist(), test_acc=ta.tolist())

    with open(os.path.join(os.getcwd(), "results.json"), "w") as f:
        json.dump(dict(budget=budget, summary=summary, runs=results), f)

    # plot
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    fig, ax = plt.subplots(1, 3, figsize=(17, 4.6))
    for name, runs in results.items():
        L = min(len(r["evals"]) for r in runs)
        x = np.array(runs[0]["evals"][:L])
        for a, key, ttl in ((ax[0], "train_loss", "Train loss"), (ax[1], "val_loss", "Validation loss"),
                            (ax[2], "test_acc", "Test accuracy")):
            Y = np.array([r[key][:L] for r in runs])
            if key == "test_acc":
                m, s = Y.mean(0), Y.std(0)
                lo, hi = m - s, m + s
            else:  # geometric mean, band = +-1 std in log space
                LY = np.log(np.maximum(Y, 1e-12))
                m, s = np.exp(LY.mean(0)), LY.std(0)
                lo, hi = m * np.exp(-s), m * np.exp(s)
            lw = 2.6 if name in ("msa", "ray", "ray_lr") else 1.6
            a.plot(x, m, label=name, lw=lw); a.fill_between(x, lo, hi, alpha=0.15)
            a.set_title(ttl); a.set_xlabel("gradient evaluations (compute)")
    ax[0].set_yscale("log"); ax[1].set_yscale("log"); ax[0].legend()
    for a in ax: a.grid(alpha=0.3)
    plt.tight_layout()
    plt.savefig(os.path.join(os.getcwd(), "results.png"), dpi=130)
    print("\nSaved results.json and results.png")


#if __name__ == "__main__":
main()
